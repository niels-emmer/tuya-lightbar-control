# Copy to .env and fill in values
# Device credentials — same device as ../lightbar, credentials validated there
DEVICE_ID=your-tuya-device-id
DEVICE_IP=192.168.101.130
DEVICE_KEY=your-local-encryption-key
DEVICE_VERSION=3.5

# Weather location (for future weather mode — Amsterdam defaults)
WEATHER_LAT=52.37
WEATHER_LON=4.89

# MQTT broker — DSMR P1 smart-meter reader (esp8266_p1meter firmware)
MQTT_HOST=192.168.101.252
MQTT_PORT=1883
MQTT_TOPIC=sensors/power/p1meter/actual_consumption
