# Copy to .env and fill in values
# Device credentials — same device as ../lightbar, credentials validated there
DEVICE_ID=your-tuya-device-id
DEVICE_IP=192.168.101.130
DEVICE_KEY=your-local-encryption-key
DEVICE_VERSION=3.5

# Weather location — first-run seed for settings.json only. After the first
# start the UI-editable settings.json is authoritative for the rain and
# air_quality effects.
WEATHER_LAT=52.37
WEATHER_LON=4.89

# MQTT broker — DSMR P1 smart-meter reader (daniel-jong/esp8266_p1meter).
# Publishes watts to sensors/power/p1meter/actual_consumption.
MQTT_HOST=192.168.101.252
MQTT_PORT=1883
MQTT_TOPIC=sensors/power/p1meter/actual_consumption

# nanoclaw-cyd-monitor daemon (~/nanoclaw-monitor) — serves Claude Pro
# session/weekly usage for the claude_usage effect. LAN-open, no auth token.
CLAUDE_USAGE_URL=http://127.0.0.1:8787/usage

# Polestar EV — charging state for the polestar effect. Uses your Polestar
# account (reverse-engineered API via pypolestar). Leave username/password
# empty to disable the effect (it shows a dim heartbeat). POLESTAR_VIN is
# optional: when empty the first vehicle on the account is used. Each poll
# performs a full login, so keep the interval long.
POLESTAR_USERNAME=
POLESTAR_PASSWORD=
POLESTAR_VIN=
POLESTAR_POLL_INTERVAL=300

# Shared-secret API key. When set, every /api/* route and the docs routes
# require it (X-API-Key header, or Authorization: Bearer <key>). Leave empty to
# disable auth (trusted LAN / local dev only) — the app logs a warning.
# Generate one with:  openssl rand -hex 32
API_KEY=
